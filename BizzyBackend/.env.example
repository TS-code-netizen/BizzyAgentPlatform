APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated browser origins allowed to call the API directly
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AWS_REGION=ap-southeast-1
BIZZY_MODEL_PROVIDER=disabled
BEDROCK_MODEL_ID=
BEDROCK_MAX_TOKENS=128
BEDROCK_READ_TIMEOUT=6
COGNITO_ISSUER=
COGNITO_CLIENT_ID=
BIZZY_AUDIT_TABLE=
BIZZY_RECORD_QUESTIONS=false
# Folder containing the BizzyData CSVs; defaults to a sibling ../BizzyData/data/demo checkout
BIZZY_DATA_DIR=../BizzyData/data/demo
# Fixed reporting cutoff; the frozen demo scenario numbers only hold for this date
BIZZY_AS_OF_DATE=2026-09-23
# Optional durable JSONL audit log; without this, audit events remain process-local
# BIZZY_AUDIT_LOG=./data/audit/events.jsonl
